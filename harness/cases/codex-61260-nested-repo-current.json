    "inner/.git/info/exclude": "* text=auto\n",
    "inner/.git/objects/info/.gitkeep": "",
    "inner/.git/objects/pack/.gitkeep": "",
    "inner/.git/refs/heads/.gitkeep": "",
    "inner/.git/refs/tags/.gitkeep": "",
    "inner/.git/branches/.gitkeep": ""
