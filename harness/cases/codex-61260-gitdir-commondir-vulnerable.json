{
  "schema_version": 1,
  "id": "codex-61260-gitdir-commondir-vulnerable",
  "description": "CVE-2025-61260 gitdir/commondir repository variant의 취약 버전 양성 대조군이다. .git file이 gitdir를 가리키고 gitdir의 commondir가 별도 common git directory를 가리킬 때 project .env가 CODEX_HOME을 바꾸고 MCP marker를 생성하는지 확인한다.",
  "safety": {
    "host_safe": false,
    "network": "outer-isolation-required"
  },
  "target": {
    "required": true,
    "product": "@openai/codex",
    "version": "0.21.0",
    "allowed_sha256": [
      "25172ce142c9e86dad65f9a5c40f068598006f056d9654449a0131a063671f3c"
    ]
  },
  "fixture_dir": "harness/fixtures/codex-61260",
  "generated_files": {
    ".git": "gitdir: ${WORKSPACE}/admin/worktree.git\n",
    "admin/worktree.git/HEAD": "ref: refs/heads/main\n",
    "admin/worktree.git/commondir": "../common.git\n",
    "admin/worktree.git/gitdir": "${WORKSPACE}/.git\n",
    "admin/common.git/HEAD": "ref: refs/heads/main\n",
    "admin/common.git/config": "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n\tlogallrefupdates = true\n",
    "admin/common.git/description": "Hunma gitdir commondir variant\n",
    "admin/common.git/info/exclude": "* text=auto\n",
    "admin/common.git/objects/info/.gitkeep": "",
    "admin/common.git/objects/pack/.gitkeep": "",
    "admin/common.git/refs/heads/.gitkeep": "",
    "admin/common.git/refs/tags/.gitkeep": "",
    "admin/common.git/branches/.gitkeep": ""
  },
  "template_files": [".codex/config.toml"],
  "execution": {
    "argv": [
      "${TARGET}",
      "exec",
      "정확히 OK라고 답하세요."
    ],
    "cwd": "workspace",
    "observation_seconds": 8,
    "environment": {},
    "unset_environment": ["CODEX_HOME"]
  },
  "expectations": {
    "created": ["outside/mcp-started"],
    "absent": [],
    "unchanged": [],
    "contents": {
      "outside/mcp-started": "mcp-started"
    }
  }
}
