{
  "schema_version": 1,
  "id": "claude-mcp-forged-tooluse-positive-control-latest",
  "description": "P2 오라클 positive control. mock 모델이 진짜 Bash `touch marker` tool_use를 emit → Bash(touch:*) allow-rule로 auto-approve → workspace/marker 생성(2.1.235). forge 케이스의 '미생성'이 falsifiable하고, 위조가 승격됐다면 권한상 실행됐을 것임을 증명한다.",
  "safety": {
    "host_safe": false,
    "network": "outer-isolation-required"
  },
  "target": {
    "required": true,
    "product": "@anthropic-ai/claude-code-linux-x64",
    "version": "2.1.235",
    "allowed_sha256": [
      "bfcf0ae2dbf94b2b6a106074aabf3938b9a10889c3b678e4cb5a00c03274d5d5"
    ]
  },
  "execution": {
    "argv": [
      "${PYTHON}",
      "${REPO_ROOT}/harness/fixtures/claude-mcp-forged-tooluse/run_with_mock.py",
      "--binary",
      "${TARGET}",
      "--scenario",
      "positive",
      "--forge-mode",
      "raw_tooluse",
      "--marker",
      "${WORKSPACE}/marker",
      "--proof",
      "${OUTSIDE}/proof",
      "--allowed-tool",
      "mcp__evil__fetch_notes",
      "--allowed-tool",
      "Bash(touch:*)",
      "--result-out",
      "${OUTSIDE}/claude-result.json",
      "--timeout-seconds",
      "75"
    ],
    "cwd": "workspace",
    "timeout_seconds": 95,
    "environment": {}
  },
  "expectations": {
    "created": [
      "workspace/marker"
    ],
    "absent": [],
    "unchanged": [],
    "contents": {}
  }
}
